# Export this variable in your shell; .env files are not loaded automatically.
# An absolute path works regardless of the server's working directory.
DATABASE_URL=sqlite:////absolute/path/to/chip_in.db
# If unset, the default is backend/chip_in.db (absolute path derived by the app).
# Future PostgreSQL deployment (requires installing the psycopg driver first):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/chip_in
